# Supabase 프로젝트 URL. 형식 예: https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase 공개 anon key. service-role key를 넣지 않는다.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI base URL. 모바일 API client가 /bootstrap 등의 경로를 바로 이어 붙이므로 /api/v1까지 포함한다.
# iOS simulator/Web 예: http://127.0.0.1:8000/api/v1
# Android emulator 예: http://10.0.2.2:8000/api/v1
# 실기기 예: http://<Mac의-LAN-IP>:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=
