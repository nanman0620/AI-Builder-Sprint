# Supabase PostgreSQL 연결 문자열.
# 형식 예: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# 실제 값은 이 파일에 넣지 않는다. 로컬에서는 apps/server/.env(git 제외)에 설정한다.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname

# Supabase 프로젝트 URL. Access Token(JWT) 검증에 필요한 JWKS endpoint와 issuer를 구성하는 데 사용한다.
# 형식 예: https://<project-ref>.supabase.co
# 실제 값은 이 파일에 넣지 않는다. 로컬에서는 apps/server/.env(git 제외)에 설정한다.
SUPABASE_URL=https://project-ref.supabase.co

# Upstage SOLAR(Chat Completions, OpenAI 호환) API key. 서버 기동 시 필수로 검증된다.
# 실제 값은 이 파일에 넣지 않는다. 로컬에서는 apps/server/.env(git 제외)에 설정한다.
# 팀원마다 console.upstage.ai에서 개인 계정으로 발급받아 각자 넣는다(팀 공용 키를 만들어
# Slack·이메일·커밋·Issue·PR로 전달하지 않는다).
SOLAR_API_KEY=

# Upstage SOLAR API base URL. 비워두면 기본값(https://api.upstage.ai/v1)을 사용한다.
SOLAR_BASE_URL=https://api.upstage.ai/v1

# 사용할 SOLAR 모델명. 비워두면 기본값(solar-pro2)을 사용한다.
SOLAR_MODEL=solar-pro2

# Google Gemini Structured Output은 CHANGE_INPUT 최종 분석에만 사용한다.
# 실제 key는 apps/server/.env에만 넣고 commit하거나 log로 남기지 않는다.
GEMINI_API_KEY=

# 사용할 Gemini 모델명. 비워두면 기본값(gemini-3.6-flash)을 사용한다.
GEMINI_MODEL=gemini-3.6-flash

# Supabase service-role key. Auth Admin API(회원탈퇴 시 auth.users 삭제)에만 사용한다.
# 절대 mobile 쪽 .env나 EXPO_PUBLIC_* 변수로 옮기지 않는다(client에 노출 금지).
# Supabase 대시보드 > Project Settings > API에서 발급받는다.
# 실제 값은 이 파일에 넣지 않는다. 로컬에서는 apps/server/.env(git 제외)에 설정한다.
SUPABASE_SERVICE_ROLE_KEY=
